{
  "manifestVersion": 5,
  "id": "com.wtv.audiowizard",
  "name": "WTVAudioWizard",
  "version": "0.8.7",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite",
    "launchProcess": {
      "extensions": ["", ".html"]
    },
    "network": {
      "domains": "all"
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "wtvAudioWizard",
      "label": {
        "default": "WTVAudioWizard"
      },
      "minimumSize": {
        "width": 280,
        "height": 340
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 540
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 560
      }
    }
  ]
}
